{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--caps",
        "vision,storage,testing",
        "--user-data-dir",
        ".playwright-profile"
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}
